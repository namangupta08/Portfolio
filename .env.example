# GitHub Personal Access Token (classic or fine-grained) to fetch contributionsCollection
# If left unset or on fetch error, the app safely falls back to a clearly labeled static snapshot.
GITHUB_TOKEN=your_github_personal_access_token_here

# When set to true, draft blog posts staged in /content/blog are displayed in the UI.
# Set to false in production until each post is ready to publish.
SHOW_DRAFTS=true
